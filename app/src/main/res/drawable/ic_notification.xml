<?xml version="1.0" encoding="utf-8"?>
<!--
     The notification icon.

     A single flat silhouette on transparency, which is all Android renders: it masks the
     shape and tints it, so anything with colour or detail arrives as a white blob.

     It was a speech bubble, on the argument that what the notification is about is a reply.
     It is now the mark, on the argument that what a status bar icon is about is which app.
     A generic bubble in a row of other apps' marks says nothing, and this is the only place
     the product appears while somebody is using something else.

     Same five numbers as ic_launcher_foreground.xml and Mark.kt: bars at 1, 0.7 and 0.41 of
     the longest, 0.22 thick, 0.32 apart. Longest is 20 in a 24 viewport, which puts the
     drawing between 3.4 and 20.6 vertically and leaves the margin the status bar expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.2,3.4h15.6a2.2,2.2 0,0 1,0 4.4h-15.6a2.2,2.2 0,0 1,0 -4.4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.2,9.8h9.6a2.2,2.2 0,0 1,0 4.4h-9.6a2.2,2.2 0,0 1,0 -4.4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.2,16.2h3.8a2.2,2.2 0,0 1,0 4.4h-3.8a2.2,2.2 0,0 1,0 -4.4z" />
</vector>
