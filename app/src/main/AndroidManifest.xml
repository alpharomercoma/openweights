<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
         Asked for the first time a reply or a download is started, which is the moment the
         phone is in the user's hand and the moment the waiting begins. Only ever used to
         say an answer is ready or how a download is going; nothing is sent anywhere.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictation only. Requested the first time the mic is tapped, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
         A model is one to eight gigabytes, which is minutes on a phone connection, and
         nobody watches a progress bar for minutes. Without a foreground service the download
         stops the moment Android reclaims the process, and the user comes back to a bar that
         has not moved. dataSync is the accurate type: bytes are being moved to storage at
         the user's request, with a notification saying so and a button to stop it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      Generation. A backgrounded app gets no CPU on Android 14: measured, oom_score_adj goes
      to 700 and the process accumulates zero ticks. Without this a reply stops when the user
      leaves, and a goal cannot run at all. See GenerationService for why no other type fits.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
         RECORD_AUDIO makes Play assume the app requires a microphone, which would hide it
         from every device without one. Dictation is one optional way to enter text, so the
         app runs perfectly well on a device that cannot record.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
         Package visibility for the on-device recogniser. Without this the system will not
         tell us whether offline speech recognition exists, and the app would have to choose
         between guessing and falling back to the online kind it has promised not to use.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OpenWeightsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenWeights"
        android:usesCleartextTraffic="false">

        <!--
             Keep phone-sized windows portrait. A QDC phone and a real handset can report their
             current physical orientation as landscape when the app starts, which made the
             first frame arrive sideways before the user had chosen to rotate anything.

             Targeting API 36 already ignores the lock at 600dp and over, so tablets and
             unfolded foldables remain rotatable and the layouts are still built for both
             directions. This only keeps a phone's first-run chat surface upright.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenWeights">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
             WorkManager runs the download in this service. It declares no type of its own,
             and from API 34 a service that starts in the foreground without one is refused,
             so the type is merged in here.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!--
             Keeps the process alive while the model answers, for a reply in front of the
             user and for a Watch checking on its own schedule alike. The subtype string is
             what Play asks about at review, and the answer is in docs/play-store.md: this
             app runs a language model on the device's own processor, and work the user
             asked for, once or on a schedule they set, has to be allowed to finish when
             they put the phone down.
        -->
        <service
            android:name=".runtime.GenerationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device language model inference the user asked for, right away or on a schedule they set" />
        </service>
        <!--
             WorkManager's own initializer would build a default configuration before the
             application class gets a say, and that configuration has no Hilt worker factory
             in it: the download worker takes an injected downloader, so it would fail to
             construct. Removing the initializer makes Configuration.Provider authoritative.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!--
             Hands the camera app a private file to write into, so taking a photo needs no
             permission at all: the app never reads the camera, it receives a file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
