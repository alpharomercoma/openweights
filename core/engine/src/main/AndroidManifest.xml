<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The GPU driver, which the app links to but does not ship.

          Qualcomm lists libOpenCL.so in /vendor/etc/public.libraries.txt, but since
          Android 12 being public is not enough: a library outside the NDK set has to be
          named here or the app's linker namespace will not resolve it, and the OpenCL
          backend fails to load with "library not found" on a device that plainly has one.

          Not required, because most devices have no OpenCL driver at all. Declaring it as
          required would make the app uninstallable on every one of them to gain a backend
          they could not have used.
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>

</manifest>
