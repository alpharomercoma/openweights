<?xml version="1.0" encoding="utf-8"?><!--
  Cleartext is allowed to exactly one host: this phone talking to itself.

  The canvas server binds the loopback interface and serves the user's own files to the
  in-app WebView and to whatever browser they open; TLS would mean shipping and trusting a
  self-signed certificate for traffic that never leaves the device. Everything else keeps
  the platform default of no cleartext at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
