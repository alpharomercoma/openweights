<?xml version="1.0" encoding="utf-8"?>
<!--
  Graphite, lifted slightly from above so the mark has somewhere to sit.

  The same radial the 512 store icon is rendered from, because Play shows the two beside
  each other and a launcher that is flatter than its own listing reads as the wrong app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="17"
                android:gradientRadius="76"
                android:startColor="#1A1E23"
                android:endColor="#0B0D0F" />
        </aapt:attr>
    </path>
</vector>
