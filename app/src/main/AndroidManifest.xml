<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
         Asked for on first launch, because a reply on a phone can take minutes and the
         phone is usually back in a pocket by then. Only ever used to say an answer is
         ready; nothing is sent anywhere.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictation only. Requested the first time the mic is tapped, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
         RECORD_AUDIO makes Play assume the app requires a microphone, which would hide it
         from every device without one. Dictation is one optional way to enter text, so the
         app runs perfectly well on a device that cannot record.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
         Package visibility for the on-device recogniser. Without this the system will not
         tell us whether offline speech recognition exists, and the app would have to choose
         between guessing and falling back to the online kind it has promised not to use.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OpenWeightsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenWeights"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
             Portrait on phones only. A chat composer with the keyboard up leaves almost no
             room in landscape, and a phone in a hand turns constantly while being read
             from. Targeting API 36 means this is ignored on displays 600dp wide and over,
             so tablets and unfolded foldables stay adaptive without an opt-out property,
             and nothing has to change when API 37 removes that opt-out.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenWeights">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
             Hands the camera app a private file to write into, so taking a photo needs no
             permission at all: the app never reads the camera, it receives a file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
