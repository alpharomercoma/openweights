<?xml version="1.0" encoding="utf-8"?>
<!--
     Encrypted everywhere, with one exception that cannot leave the phone.

     The app blocks cleartext because one of its tools fetches an address the model chose.
     An unencrypted request to an address nobody vetted is the one place in this app where
     a network attacker gets to change what the model reads, so http stays off.

     Loopback is exempt because nothing on it crosses a wire. It is what makes a local
     proxy, or an adb reverse tunnel to a SearXNG running on a desktop, usable during
     development without weakening the rule for anything that is actually remote.

     A SearXNG on another machine still has to be https. That is a real cost and it is the
     right side of the trade: the alternative is permitting cleartext to every host on the
     internet so that one host on a home network can be reached.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
